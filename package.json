{
  "name": "mcp-replay",
  "version": "0.1.0",
  "description": "Record and replay MCP server interactions for deterministic testing — nock/msw for MCP",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "replay",
    "fixtures",
    "mock"
  ],
  "homepage": "https://github.com/mstuart/mcp-replay#readme",
  "bugs": {
    "url": "https://github.com/mstuart/mcp-replay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstuart/mcp-replay.git"
  },
  "license": "MIT",
  "author": "Mark Stuart",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "tsc && node --test 'dist/tests/*.test.js'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "ultracite": "7.10.2"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  }
}
